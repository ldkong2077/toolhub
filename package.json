{
  "name": "toolhub",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "next build && node scripts/fix-paths.mjs",
    "start": "npx --yes serve out",
    "lint": "eslint .",
    "pack": "npm run build:static && cd out && zip -r ../toolhub.zip . && cd .. && echo 'Packed: toolhub.zip'"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
